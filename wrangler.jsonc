{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mlbbchatidbot",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "queues": {
    "producers": [
      {
        "binding": "BIND_INFO_QUEUE",
        "queue": "mlbbchatidbot-bind-info"
      },
      {
        "binding": "BROADCAST_QUEUE",
        "queue": "mlbbchatidbot-broadcast"
      }
    ],
    "consumers": [
      {
        "queue": "mlbbchatidbot-bind-info",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1
      },
      {
        "queue": "mlbbchatidbot-broadcast",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2
      }
    ]
  },
  "vars": {
    "MAIN_GROUP_ID": "-1003832186200",
    "SUPPORT_USERNAME": "Ksava_org",
    "ADMIN_IDS": "5081175125,7396686285",
    "TELEGRAM_BOT_USERNAME": "checkmlbbidBot",
    "MLBB_LOOKUP_API_URL": "https://api.isan.eu.org/nickname/ml",
    "ADVANCED_SERVER_RANGES": "5101-5800",
    "SUPABASE_URL": "https://trybbxovootehqvaiydn.supabase.co",
    "MLBB_BIND_INFO_PROVIDER": "bengkel",
    "MLBB_BIND_INFO_API_URL": "https://mlbbchatidbot.vercel.app/api/bengkel",
    "MLBB_BIND_INFO_API_METHOD": "POST",
    "MLBB_BIND_INFO_BENGKEL_BOT_USERNAME": "bengkelmlbb_bot",
    "MLBB_BIND_INFO_BENGKEL_MESSAGE_TEMPLATE": "/info {account_id} {zone_id}",
    "MLBB_BIND_INFO_TIMEOUT_MS": "120000",
    "TELEGRAM_TIMEOUT_MS": "5000",
    "MLBB_BRIDGE_URL": "https://mlbbchatidbot.vercel.app/api/bengkel",
    "FULL_INFO_API": "https://api.jebray.com",
    "FULL_INFO_TIMEOUT_MS": "30000",
    "FULL_INFO_RETRIES": "2",
    "TELEGRAPH_TIMEOUT_MS": "10000"
  }
}
