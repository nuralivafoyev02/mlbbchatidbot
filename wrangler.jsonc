{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mlbbchatidbot",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ASYNC_RUNNER",
        "class_name": "AsyncRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AsyncRunner"]
    }
  ],
  // Ommaviy API (/v1) rate limit: token boshiga 60 so'rov / 60 s
  // (public-api.mjs RATE_LIMIT bilan bir xil bo'lsin).
  "ratelimits": [
    { "name": "PUBLIC_API_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BIND_INFO_QUEUE",
        "queue": "mlbbchatidbot-bind-info"
      },
      {
        "binding": "BROADCAST_QUEUE",
        "queue": "mlbbchatidbot-broadcast"
      }
    ],
    "consumers": [
      {
        "queue": "mlbbchatidbot-bind-info",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1
      },
      {
        "queue": "mlbbchatidbot-broadcast",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2
      }
    ]
  },
  // Prod ham dev kabi yo'l bo'yicha bo'linadi: mlbb.nurali.uz/tg* (Telegram
  // webhook) → shu Worker, WAF faqat Telegram IP'lari; qolgan hammasi
  // (Mini App, /api/*) → Cloudflare orqali Vercel production.
  "routes": [
    { "pattern": "mlbb.nurali.uz/tg*", "zone_name": "nurali.uz" },
    // Ommaviy nickname+region API (public-api.mjs) — edge'da, kesh bilan.
    { "pattern": "mlbb.nurali.uz/v1*", "zone_name": "nurali.uz" }
  ],
  // workers.dev va versiya preview manzillari yopiq — Worker faqat
  // mlbb.nurali.uz/tg* orqali ishga tushadi (limitga ham qo'shilmaydi).
  "workers_dev": false,
  "preview_urls": false,
  // Webhook kuzatuvi + 23:50 dagi kunlik holat hisoboti (webhook-monitor.mjs,
  // health-report.mjs). Free plan: akkauntga 5 ta cron — bu bilan 5/5.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "MAIN_GROUP_ID": "-5345450308",
    "SUPPORT_USERNAME": "Ksava_org",
    "ADMIN_IDS": "5081175125,7396686285",
    "TELEGRAM_BOT_USERNAME": "checkmlbbidBot",
    // Kunlik holat hisoboti (health-report.mjs): Cloudflare statistikasi
    // shu Worker nomi bo'yicha; token — `wrangler secret put CF_ANALYTICS_TOKEN`.
    "WORKER_NAME": "mlbbchatidbot",
    "CF_ACCOUNT_ID": "47f7e844771fdf5c35456fd8337f940a",
    "MLBB_LOOKUP_API_URL": "https://api.isan.eu.org/nickname/ml",
    "ADVANCED_SERVER_RANGES": "5101-5800",
    "SUPABASE_URL": "https://trybbxovootehqvaiydn.supabase.co",
    "MLBB_BIND_INFO_TIMEOUT_MS": "120000",
    "TELEGRAM_TIMEOUT_MS": "5000",
    "FULL_INFO_API": "https://api.jebray.com",
    "FULL_INFO_TIMEOUT_MS": "30000",
    "FULL_INFO_RETRIES": "2",
    "TELEGRAPH_TIMEOUT_MS": "10000",
    "BROADCAST_RATE_PER_SEC": "25",
    "BROADCAST_BATCH_SIZE": "25",
    "BROADCAST_MAX_SENDS_PER_RUN": "40",
    "MINIAPP_URL": "https://mlbb.nurali.uz/api/miniapp",
    "ACCOUNT_MINIAPP_URL": "https://mlbb.nurali.uz/api/account",
    "BOT_LOGO_URL": "https://mlbb.nurali.uz/logo.jpg"
  },
  // Dev (beta) muhiti: `npx wrangler deploy --env dev`.
  // Alohida Worker (mlbbchatidbot-dev) + alohida Durable Object namespace.
  // Queues ataylab yo'q (meros qilinmaydi ham) — DO asosiy yo'l.
  // Maxfiy qiymatlar (TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
  // SUPABASE_SERVICE_KEY, FULL_INFO_API_KEY) `wrangler secret put ... --env dev`.
  "env": {
    "dev": {
      "name": "mlbbchatidbot-dev",
      // Faqat o'z domeni orqali: workers.dev va versiya preview manzillari
      // yopiq — u yerga kelgan so'rov Worker'ni ishga tushirmaydi (limitga
      // ham qo'shilmaydi). dev-mlbb.nurali.uz da yo'l bo'yicha bo'linadi:
      // /tg* (Telegram webhook) → shu Worker, WAF faqat Telegram IP'lari;
      // qolgan hammasi (Mini App, /api/*) → Cloudflare orqali Vercel dev.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "dev-mlbb.nurali.uz/tg*", "zone_name": "nurali.uz" },
        { "pattern": "dev-mlbb.nurali.uz/v1*", "zone_name": "nurali.uz" }
      ],
      // Webhook kuzatuvi + kunlik holat hisoboti (prod'dagi kabi).
      "triggers": {
        "crons": ["*/10 * * * *"]
      },
      // Faqat beta: account Mini App'ining Vercel Preview muhitida ham
      // JEBRAY_DEVICE_LOGOUT_ENABLED=true va beta'dagi FULL_INFO_API_KEY
      // (yoki alohida JEBRAY_RESELLER_API_KEY) secret kerak.
      "durable_objects": {
        "bindings": [
          {
            "name": "ASYNC_RUNNER",
            "class_name": "AsyncRunner"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["AsyncRunner"]
        }
      ],
      "ratelimits": [
        { "name": "PUBLIC_API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": {
        "MAIN_GROUP_ID": "-5345450308",
        "SUPPORT_USERNAME": "Ksava_org",
        "ADMIN_IDS": "5081175125,7396686285",
        "TELEGRAM_BOT_USERNAME": "devcheckmlbbidBot",
        "WORKER_NAME": "mlbbchatidbot-dev",
        "CF_ACCOUNT_ID": "47f7e844771fdf5c35456fd8337f940a",
        "MLBB_LOOKUP_API_URL": "https://api.isan.eu.org/nickname/ml",
        "ADVANCED_SERVER_RANGES": "5101-5800",
        "SUPABASE_URL": "https://trybbxovootehqvaiydn.supabase.co",
        "FULL_INFO_API": "https://api.jebray.com",
        "FULL_INFO_TIMEOUT_MS": "30000",
        "FULL_INFO_RETRIES": "2",
        "JEBRAY_DEVICE_LOGOUT_ENABLED": "true",
        "TELEGRAM_TIMEOUT_MS": "5000",
        "BROADCAST_RATE_PER_SEC": "25",
        "BROADCAST_BATCH_SIZE": "25",
        "BROADCAST_MAX_SENDS_PER_RUN": "40",
        "MINIAPP_URL": "https://dev-mlbb.nurali.uz/api/miniapp",
        "ACCOUNT_MINIAPP_URL": "https://dev-mlbb.nurali.uz/api/account",
        "BOT_LOGO_URL": "https://dev-mlbb.nurali.uz/logo.jpg"
      }
    }
  }
}
